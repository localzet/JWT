{
  "name": "localzet/jwt",
  "description": "Compact JWT signing and verification with explicit algorithm selection and strict JWA signature encoding.",
  "type": "library",
  "keywords": [
    "JSON Web Tokens",
    "JWT",
    "PHP",
    "library",
    "localzet",
    "AGPL",
    "openssl",
    "mbstring"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "role": "Developer",
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://github.com/localzet"
    }
  ],
  "support": {
    "email": "support@localzet.com",
    "issues": "https://github.com/localzet/JWT/issues",
    "source": "https://github.com/localzet/JWT"
  },
  "require": {
    "php": ">=8.2",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "ext-json": "*"
  },
  "suggest": {
    "ext-sodium": "For EdDSA"
  },
  "autoload": {
    "psr-4": {
      "localzet\\": "src"
    }
  },
  "scripts": {
    "test": "php tests/security.php"
  }
}
